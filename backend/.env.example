# OpenRouter API Key for Multi-LLM Fallback Engine
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Manager Email (receives urgent escalation alerts)
MANAGER_EMAIL=manager@example.com

# Backend URL (used in 1-Click Action buttons in emails)
BACKEND_URL=http://localhost:8000

# Gmail SMTP Settings (App Password required for Gmail)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password_here
